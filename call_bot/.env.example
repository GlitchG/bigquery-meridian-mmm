# ── Telegram ──────────────────────────────────────────────────────────────────
# Получить у @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Asana ─────────────────────────────────────────────────────────────────────
# Personal Access Token: https://app.asana.com/0/my-apps
ASANA_ACCESS_TOKEN=your_asana_pat_here

# Workspace GID: открой любую задачу в браузере, в URL будет /0/<workspace_gid>/...
# Или GET https://app.asana.com/api/1.0/workspaces
ASANA_WORKSPACE_GID=your_workspace_gid

# Project GID: открой проект в браузере — последний числовой сегмент URL
ASANA_PROJECT_GID=your_project_gid

# ── Ollama / Hermes ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hermes3          # или nous-hermes2, hermes3:8b и т.д.

# ── Whisper ───────────────────────────────────────────────────────────────────
WHISPER_MODEL=large-v3-turbo  # large-v3-turbo, large-v3, medium и т.д.
WHISPER_DEVICE=cuda           # cuda / cpu
WHISPER_COMPUTE_TYPE=float16  # float16 (GPU), int8 (CPU)
WHISPER_LANGUAGE=ru

# ── Прочее ────────────────────────────────────────────────────────────────────
AUDIO_MAX_SIZE_MB=200
