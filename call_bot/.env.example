# ── Telegram ──────────────────────────────────────────────────────────────────
# Получить у @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── ClickUp ───────────────────────────────────────────────────────────────────
# Personal API Token: https://app.clickup.com/settings/apps
CLICKUP_API_TOKEN=pk_your_token_here

# List ID: открой список в браузере, в URL будет /v/li/<LIST_ID>
# Или через API: GET https://api.clickup.com/api/v2/team (найди нужный список)
CLICKUP_LIST_ID=your_list_id_here

# ── Ollama / Hermes ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hermes3          # или nous-hermes2, hermes3:8b и т.д.

# ── Whisper ───────────────────────────────────────────────────────────────────
WHISPER_MODEL=large-v3-turbo  # large-v3-turbo, large-v3, medium и т.д.
WHISPER_DEVICE=cuda           # cuda / cpu
WHISPER_COMPUTE_TYPE=float16  # float16 (GPU), int8 (CPU)
WHISPER_LANGUAGE=ru

# ── Прочее ────────────────────────────────────────────────────────────────────
AUDIO_MAX_SIZE_MB=200
